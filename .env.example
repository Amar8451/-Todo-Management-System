# Firebase Configuration
# Get these values from your Firebase console at https://console.firebase.google.com/
# Project Settings > General > SDK setup and configuration
#
# Instructions:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Enable Firestore Database (Build > Firestore Database)
# 3. Go to Project Settings > General
# 4. Scroll to "Your apps" and click on your web app
# 5. Copy the config values below
#
# For Local Development:
# - Copy these values to .env.local with actual Firebase credentials
# - If you skip Firebase setup, the app falls back to JSON Server (npm run dev)
#
# For Vercel Deployment:
# - Add these environment variables to Vercel project settings
# - Vercel will inject them during build and runtime

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
