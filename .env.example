# ─── Backend (Express server) ──────────────────────────────────────────────
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?appName=Cluster0

# Port for local Express server
PORT=5000

# ─── Frontend (Vite build) ─────────────────────────────────────────────────
# Set this to your deployed backend URL (e.g. Render.com)
# Used at build time — set as a GitHub Secret named VITE_API_URL
VITE_API_URL=https://your-backend.onrender.com/api
